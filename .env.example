# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://getnorthmedia.com

# Business email — NOT FINALISED. Leave empty until confirmed; the site then hides
# email links and shows "Coming soon" on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Enquiry form delivery: configure at least ONE option ----
# Without either, the form tells visitors it isn't connected and offers WhatsApp instead.

# Option 1: Email via Resend (https://resend.com). Verify getnorthmedia.com in Resend first.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="GetNorth Website <website@getnorthmedia.com>"

# Option 2: JSON webhook (Zapier, Make, n8n, Google Apps Script, CRM...)
CONTACT_WEBHOOK_URL=
